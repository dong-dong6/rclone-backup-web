# ============================================
# Rclone Backup Web V2.0 - Environment Configuration
# ============================================
# Copy this file to .env and update with your values

# ============================================
# Database Configuration
# ============================================
DB_NAME=rclone_backup
DB_USER=rclone
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ============================================
# Security Keys (Required - Generate strong random keys!)
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_64_CHAR_RANDOM_STRING_FOR_JWT_SIGNING
ENCRYPTION_KEY=CHANGE_THIS_32_CHAR_KEY_FOR_AES256

# ============================================
# Service Ports
# ============================================
# Hub API Port (Backend)
HUB_PORT=8080

# Web UI Port (Frontend)
WEB_PORT=3000

# Prometheus Metrics Port
METRICS_PORT=9090

# ============================================
# Application Settings
# ============================================
# Environment: development, staging, production
GIN_MODE=release

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# Version tag
VERSION=1.0.0

# ============================================
# Hub Configuration
# ============================================
# Session timeout (e.g., 24h, 7d)
SESSION_TIMEOUT=24h

# API Key expiry (e.g., 365d, never)
API_KEY_EXPIRY=365d

# Enable features
ENABLE_METRICS=true
ENABLE_PROFILING=false

# ============================================
# Frontend Configuration
# ============================================
# API URL for frontend (update for production)
API_URL=http://localhost:8080
SSE_URL=http://localhost:8080

# ============================================
# Redis Configuration (Optional)
# ============================================
REDIS_MAX_MEMORY=256mb

# ============================================
# Agent Configuration (for docker-compose.agent.yml)
# ============================================
# Hub connection
HUB_URL=http://your-hub-domain.com:8080

# Agent identification (leave empty for auto-registration)
AGENT_ID=
AGENT_API_KEY=
REGISTRATION_TOKEN=

# Agent name (defaults to hostname)
AGENT_NAME=

# Agent behavior
HEARTBEAT_INTERVAL=30s
TASK_TIMEOUT=2h
ENABLE_LOCAL_FALLBACK=true
LOCAL_FALLBACK_THRESHOLD=5m

# Rclone configuration
USE_SIDECAR=true
RCLONE_VERSION=latest
RCLONE_LOG_LEVEL=INFO
RCLONE_CPU_LIMIT=2.0
RCLONE_MEMORY_LIMIT=1G
RCLONE_RC_USER=
RCLONE_RC_PASS=

# Backup source paths (customize as needed)
BACKUP_SOURCE_1=/var/www
BACKUP_SOURCE_2=/home
BACKUP_SOURCE_3=/etc