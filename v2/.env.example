# ============================================
# Rclone Backup Web V2.0 - Environment Configuration
# ============================================
# Copy this file to .env and update with your values

# ============================================
# Database Configuration
# ============================================
DB_NAME=rclone_backup
DB_USER=rclone
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ============================================
# Security Keys (Required - Generate strong random keys!)
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_64_CHAR_RANDOM_STRING_FOR_JWT_SIGNING
ENCRYPTION_KEY=CHANGE_THIS_32_CHAR_KEY_FOR_AES256

# ============================================
# Service Ports
# ============================================
# Hub API Port (Backend)
HUB_PORT=8080

# Web UI Port (Frontend)
WEB_PORT=3000

# Prometheus Metrics Port
METRICS_PORT=9090

# ============================================
# Application Settings
# ============================================
# Environment: development, staging, production
GIN_MODE=release

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# Version tag
VERSION=1.0.0

# Docker image names
HUB_IMAGE=rclone-backup-hub
WEB_IMAGE=rclone-backup-web
AGENT_IMAGE=rclone-backup-agent

# ============================================
# Hub Configuration
# ============================================
# Session timeout (e.g., 24h, 7d)
SESSION_TIMEOUT=24h

# API Key expiry (e.g., 365d, never)
API_KEY_EXPIRY=365d

# Enable features
ENABLE_METRICS=true
ENABLE_PROFILING=false

# ============================================
# Frontend Configuration
# ============================================
# API URL for frontend (update for production)
API_URL=http://localhost:8080
SSE_URL=http://localhost:8080

# ============================================
# Redis Configuration
# ============================================
REDIS_MAX_MEMORY=256mb

# ============================================
# Database Backup Configuration
# ============================================
# Backup interval in seconds (86400 = 24 hours)
DB_BACKUP_INTERVAL=86400

# ============================================
# Optional: Local Agent Configuration
# ============================================
# Fill these variables if you want to deploy an agent on the Hub server
# itself to back it up. Then use `make up-with-agent` to start.
# ---------------------------------------------------------------------

# Option 1: Registration Token (for first-time setup)
# Get this token from the Hub UI (Agents -> Generate Registration Token)
LOCAL_AGENT_REGISTRATION_TOKEN=

# Option 2: Existing Credentials (after registration)
# These will be automatically saved after first registration
LOCAL_AGENT_ID=
LOCAL_AGENT_API_KEY=

# Agent Configuration
LOCAL_AGENT_NAME=hub-local-agent
HEARTBEAT_INTERVAL=30s
TASK_TIMEOUT=2h
ENABLE_LOCAL_FALLBACK=true
LOCAL_FALLBACK_THRESHOLD=5m

# Rclone Configuration
RCLONE_VERSION=latest
RCLONE_LOG_LEVEL=INFO
RCLONE_CPU_LIMIT=2.0
RCLONE_MEMORY_LIMIT=1G