# Hub Connection Configuration
HUB_URL=http://hub.example.com
AGENT_ID=
AGENT_API_KEY=

# Agent Configuration
HEARTBEAT_INTERVAL=30s
CONFIG_CACHE_DIR=/var/lib/rclone-agent

# Rclone Sidecar Configuration
RCLONE_ENDPOINT=http://rclone-sidecar:5572

# Local Fallback Configuration
ENABLE_LOCAL_FALLBACK=true
FALLBACK_CHECK_INTERVAL=5m

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/rclone-agent/agent.log