# ============================================
# Rclone Backup Web V2.0 - Environment Configuration
# ============================================
# Copy this file to .env and update with your values

# ============================================
# Database Configuration
# ============================================
DB_NAME=rclone_backup
DB_USER=rclone
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ============================================
# Security Keys (Required - Generate strong random keys!)
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_64_CHAR_RANDOM_STRING_FOR_JWT_SIGNING
ENCRYPTION_KEY=CHANGE_THIS_32_CHAR_KEY_FOR_AES256

# ============================================
# Service Ports
# ============================================
# Web UI Port (统一入口，所有服务通过此端口访问)
WEB_PORT=3000

# 以下端口已改为内部使用，不再需要配置
# HUB_PORT=8080        # Hub API容器内部端口（固定）
# METRICS_PORT=9090    # Metrics容器内部端口（固定）

# ============================================
# Application Settings
# ============================================
# Environment: development, staging, production
GIN_MODE=release

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# Version tag (用于镜像标签)
VERSION=1.0.0

# ============================================
# Hub Configuration
# ============================================
# Session timeout (e.g., 24h, 7d)
SESSION_TIMEOUT=24h

# API Key expiry (e.g., 365d, never)
API_KEY_EXPIRY=365d

# Enable features
ENABLE_METRICS=true
ENABLE_PROFILING=false

# ============================================
# Frontend Configuration
# ============================================
# API URL for frontend (update for production)
API_URL=http://localhost:8080
SSE_URL=http://localhost:8080

# ============================================
# Redis Configuration
# ============================================
REDIS_MAX_MEMORY=256mb

# ============================================
# Database Backup Configuration
# ============================================
# Backup interval in seconds (86400 = 24 hours)
DB_BACKUP_INTERVAL=86400